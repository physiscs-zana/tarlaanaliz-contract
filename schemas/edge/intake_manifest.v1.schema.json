{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.tarlaanaliz.com/schemas/edge/intake_manifest.v1.schema.json",
  "title": "IntakeManifest",
  "description": "İstasyona alınan batch manifesti — chain-of-custody kanıt kaydı. KR-072 + KR-073 kanonik. SUPERSET (contracts v3.0.0): oneOf ile iki ayrık formu valide eder — (1) platform-kanonik form; (2) edge operasyonel form (kiosk'un gerçek emit ettiği). Edge=üretici, Platform=tüketici: bu oneOf edge↔platform kontrat boşluğunu kapatır.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/PlatformForm"
    },
    {
      "$ref": "#/$defs/EdgeForm"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "PlatformForm": {
      "type": "object",
      "title": "Platform-canonical intake manifest",
      "description": "İstasyona alınan batch manifesti (platform-kanonik form). batch_id = batch_<24hex>; files[].sha256_hash; dataset_status; AvScanResult.findings(threat_type).",
      "required": [
        "batch_id",
        "kiosk_id",
        "operator_id",
        "card_id",
        "drone_serial",
        "drone_model",
        "files",
        "signature",
        "av_scan_result",
        "created_at"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "pattern": "^batch_[a-z0-9]{24}$",
          "description": "Batch kimliği. Format: batch_{24-char-hex}. Eşleştirme hiyerarşisi: MissionID → BatchID → FieldID."
        },
        "kiosk_id": {
          "type": "string",
          "description": "Hangi istasyondan yüklendiği. mTLS sertifikası ile eşleşmeli."
        },
        "operator_id": {
          "type": "string",
          "description": "İşlemi yapan operatörün user_id değeri. Audit log için kritik (PII değil, pseudonymous)."
        },
        "card_id": {
          "type": "string",
          "description": "SD kart envanter kimliği. QR etiket veya fiziksel etiket ile eşleşmeli."
        },
        "drone_serial": {
          "type": "string",
          "description": "EXIF'ten çıkarılan drone seri numarası. drone_registry.yaml'daki kayıtlı seri numaralarıyla whitelist kontrolü yapılır. Kayıtlı değilse batch REJECTED_QUARANTINE."
        },
        "drone_model": {
          "$ref": "../../enums/drone_type.enum.v1.json",
          "description": "Drone model enum değeri (drone-agnostik). DJI_MAVIC_3M birincil/önerilen; desteklenen diğer modeller enum'da kayıtlı. KR-015 + KR-030 + KR-034."
        },
        "mission_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mission_[a-z0-9]{24}$",
          "description": "Eşleştirilen görev kimliği (opsiyonel). EXIF veya dosya adından çıkarılır. Bulunamazsa coğrafi eşleştirme denenir, yoksa manuel inceleme kuyruğu."
        },
        "field_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^field_[a-z0-9]{24}$",
          "description": "Eşleştirilen tarla kimliği (opsiyonel). Coğrafi eşleştirme sonucu veya explicit."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "description": "İstasyona alınan dosyaların listesi. Her dosya için hash zorunlu.",
          "items": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "filename",
              "size_bytes",
              "sha256_hash",
              "mime_type"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "description": "Dosya adı. Whitelist uzantıları: .tif, .tiff, .jpg, .jpeg, .raw, .dng."
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 özet değeri. Hash uyuşmazlığı → REJECTED_QUARANTINE."
              },
              "mime_type": {
                "type": "string",
                "enum": [
                  "image/tiff",
                  "image/jpeg",
                  "image/x-raw",
                  "image/x-dng"
                ]
              },
              "captured_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "EXIF'ten çekim zamanı."
              },
              "gps_lat": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "GPS enlemi (WGS84)."
              },
              "gps_lon": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "GPS boylamı (WGS84)."
              }
            }
          }
        },
        "signature": {
          "type": "string",
          "description": "GPG/RSA dijital imza. Kiosk'un özel anahtarı ile imzalanır; platform kiosk'un public key'i ile doğrular."
        },
        "av_scan_result": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "status",
            "scanned_at",
            "engine_id",
            "signatures_version"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CLEAN",
                "THREAT_FOUND",
                "SCAN_ERROR"
              ],
              "description": "CLEAN olmadan batch RELEASE edilemez."
            },
            "scanned_at": {
              "type": "string",
              "format": "date-time"
            },
            "engine_id": {
              "type": "string",
              "description": "AV motor kimliği."
            },
            "signatures_version": {
              "type": "string",
              "description": "AV imza veri tabanı versiyonu."
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "threat_name": {
                    "type": "string"
                  },
                  "threat_type": {
                    "$ref": "../../enums/threat_type.enum.v1.json"
                  }
                },
                "unevaluatedProperties": false
              }
            },
            "quarantined": {
              "type": "boolean",
              "description": "THREAT_FOUND durumunda true; dosyalar karantinaya alındı."
            }
          },
          "description": "AV tarama sonucu (AV1 — edge taraması). av_scan_result olmadan batch RELEASE edilemez."
        },
        "dataset_status": {
          "$ref": "../../enums/dataset_status.enum.v1.json",
          "description": "Dataset yaşam döngüsü durumu. KR-072 state machine. İstasyon tarafı: RAW_INGESTED → RAW_SCANNED_EDGE_OK → RAW_HASH_SEALED."
        },
        "available_bands": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "GREEN",
              "RED",
              "RED_EDGE",
              "NIR",
              "BLUE",
              "LWIR"
            ]
          },
          "description": "Sensörün ürettiği spektral bantlar. Minimum 4 bant zorunlu (GREEN + RED + RED_EDGE + NIR). Blue bant mevcutsa genişletilmiş analiz, LWIR mevcutsa termal pipeline etkinleşir. drone_capability_matrix.yaml ile çapraz doğrulanır. KR-018/KR-082 v1.2.0."
        },
        "calibration_type": {
          "type": "string",
          "enum": [
            "ABSOLUTE",
            "RELATIVE",
            "PANEL_ABSOLUTE",
            "DLS2_RELATIVE"
          ],
          "description": "Radyometrik kalibrasyon tipi (KR-018). DJI Mavic 3M RELATIVE üretir. Opsiyonel, geriye uyumlu; edge→platform→worker calibration_metadata.calibration_type için KAYNAK. Platform ABSOLUTE'u worker PANEL_ABSOLUTE'una normalize eder; yoksa CALIBRATED→PANEL_ABSOLUTE varsayar (güvenlik-ağı). Kanonik vocabulary: enums/calibration_type.enum.v1.json."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Manifest oluşturulma zamanı (ISO 8601)."
        },
        "quarantined_file_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Edge/AV1 tarafında manifest gönderilmeden ÖNCE yerelde karantinaya alınıp düşürülen dosya sayısı (bu dosyalar files[]'a GİRMEZ). Opsiyonel, geriye uyumlu — pre-v7.2.0 üreticiler atlar. Platform admin panosunda >0 iken DAİMA uyarı olarak yüzeye çıkarılır. Operatör görünürlüğü değil; merkez/AV2 REJECTED_QUARANTINE'den ayrı sinyaldir."
        },
        "quarantined_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Edge/AV1 tarafında yerelde düşürülen karantina dosyalarının toplam boyutu (bayt). Opsiyonel, geriye uyumlu. quarantined_file_count ile birlikte anlamlıdır."
        }
      },
      "unevaluatedProperties": false
    },
    "EdgeForm": {
      "description": "Edge operasyonel form (kiosk emitter). schema_version=1.2; batch_id=BATCH_YYYYMMDD_HHMMSS_XXXX; drone_make+drone_model(inline enum); files[].sha256; available_bands; priority_zones(NDVI); correlation_id.",
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.2"
        },
        "batch_id": {
          "type": "string",
          "pattern": "^BATCH_[0-9]{8}_[0-9]{6}_[A-Z0-9]{4}$",
          "description": "Batch identifier. Format: BATCH_YYYYMMDD_HHMMSS_XXXX."
        },
        "kiosk_id": {
          "type": "string",
          "minLength": 1,
          "description": "Kiosk station identifier (maps to station_id). Must match mTLS certificate."
        },
        "operator_id": {
          "type": "string",
          "minLength": 1,
          "description": "Operator user_id performing the intake. Pseudonymous, not PII."
        },
        "card_id": {
          "type": "string",
          "minLength": 1,
          "description": "SD card inventory ID. QR label or physical tag."
        },
        "drone_serial": {
          "type": "string",
          "minLength": 1,
          "description": "Serial number of the drone. Must be registered in drone_registry.yaml."
        },
        "drone_make": {
          "type": "string",
          "enum": [
            "DJI",
            "WingtraOne",
            "Parrot",
            "AgEagle"
          ],
          "description": "Drone manufacturer short name (edge-internal validation)."
        },
        "drone_model": {
          "type": "string",
          "enum": [
            "DJI_MAVIC_3M",
            "DJI_M350_RTK_SENTERA_6X",
            "WINGTRAONE_GEN2_MICASENSE_REDEDGE_P",
            "PARROT_ANAFI_USA_SEQUOIA_PLUS",
            "AGEAGLE_EBEE_X_ALTUM_PT"
          ],
          "description": "Drone model enum from Contract SSOT drone_type.enum.v1. Sent to platform."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 hash of file content."
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "mime_type": {
                "type": "string",
                "enum": [
                  "image/tiff",
                  "image/jpeg",
                  "image/x-raw",
                  "image/x-dng"
                ]
              },
              "captured_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "EXIF capture timestamp."
              }
            },
            "required": [
              "filename",
              "sha256",
              "size_bytes",
              "mime_type"
            ],
            "additionalProperties": false
          },
          "description": "List of files contained in the ingested card."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "GPG/RSA digital signature. Kiosk private key signs; platform verifies."
        },
        "av_scan_result": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CLEAN",
                "THREAT_FOUND",
                "SCAN_ERROR"
              ]
            },
            "scanned_at": {
              "type": "string",
              "format": "date-time"
            },
            "engine_id": {
              "type": "string"
            },
            "signatures_version": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "scanned_at",
            "engine_id",
            "signatures_version"
          ],
          "additionalProperties": false,
          "description": "AV1 edge scan result. CLEAN required for batch release."
        },
        "available_bands": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "GREEN",
              "RED",
              "RED_EDGE",
              "NIR",
              "BLUE",
              "LWIR"
            ]
          },
          "description": "Spectral bands produced by the sensor. Minimum 4 required (GREEN+RED+RED_EDGE+NIR)."
        },
        "calibration_type": {
          "type": "string",
          "enum": [
            "ABSOLUTE",
            "RELATIVE",
            "PANEL_ABSOLUTE",
            "DLS2_RELATIVE"
          ],
          "description": "Radyometrik kalibrasyon tipi (KR-018). DJI Mavic 3M RELATIVE üretir. Opsiyonel, geriye uyumlu; edge→platform→worker calibration_metadata.calibration_type için KAYNAK. Platform ABSOLUTE'u worker PANEL_ABSOLUTE'una normalize eder; yoksa CALIBRATED→PANEL_ABSOLUTE varsayar (güvenlik-ağı). Kanonik vocabulary: enums/calibration_type.enum.v1.json."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp of manifest creation."
        },
        "quarantined_file_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of files AV1 quarantined/dropped locally BEFORE manifest emission (never enter files[]). Optional, backward compatible. Platform surfaces as an always-on admin warning when >0."
        },
        "quarantined_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total size in bytes of the AV1-quarantined files dropped locally. Optional, backward compatible. Meaningful together with quarantined_file_count."
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^corr_[a-f0-9]{16,32}$",
          "description": "Request-scoped trace identifier."
        },
        "mission_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Optional planned mission identifier."
        },
        "field_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Optional field identifier from spatial matching."
        },
        "priority_zones": {
          "type": "array",
          "maxItems": 500,
          "description": "M1 NdviPrioritizer output (FAZ 8.5) -- problem-zone patches + random sample. Optional, backward compatible.",
          "items": {
            "type": "object",
            "properties": {
              "patch_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$",
                "description": "UUID4 hex (32 chars, no dashes)."
              },
              "geom": {
                "type": "object",
                "description": "GeoJSON Polygon (WGS84). HC-02 compliant: patch boundary only, never atomic GPS point.",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 3,
                        "items": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "coordinates"
                ],
                "additionalProperties": false
              },
              "priority_level": {
                "type": "string",
                "enum": [
                  "EXPRESS",
                  "NORMAL"
                ]
              },
              "ndvi_value": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "description": "Patch mean NDVI value."
              },
              "sampling_reason": {
                "type": "string",
                "enum": [
                  "NDVI_THRESHOLD",
                  "RANDOM_SAMPLE"
                ]
              },
              "visualizations": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Relative paths under patches/<patch_id>/ -- path traversal explicitly disallowed.",
                "properties": {
                  "true_color": {
                    "type": "string",
                    "pattern": "^patches/[a-f0-9]{32}/true_color\\.jpg$"
                  },
                  "false_color": {
                    "type": "string",
                    "pattern": "^patches/[a-f0-9]{32}/false_color\\.jpg$"
                  },
                  "ndvi_overlay": {
                    "type": "string",
                    "pattern": "^patches/[a-f0-9]{32}/ndvi_overlay\\.png$"
                  }
                },
                "required": [
                  "true_color",
                  "false_color",
                  "ndvi_overlay"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "patch_id",
              "geom",
              "priority_level",
              "ndvi_value",
              "sampling_reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "batch_id",
        "kiosk_id",
        "operator_id",
        "card_id",
        "drone_serial",
        "drone_make",
        "drone_model",
        "files",
        "signature",
        "av_scan_result",
        "available_bands",
        "created_at",
        "correlation_id"
      ],
      "title": "Edge operational intake manifest",
      "unevaluatedProperties": false
    }
  },
  "x-kr-ref": [
    "KR-072",
    "KR-073",
    "KR-015",
    "KR-030"
  ],
  "x-ssot-version": "1.2.0",
  "x-updated": "2026-05-30"
}
